<script type="text/javascript">

function massge() {
Swal.fire({
  title: 'Success',
text: '{{\Session::get('status')}}',
timer: 2000,
icon:'success',
showCancelButton: false,
showConfirmButton: false
}).then(
function () {},
// handling the promise rejection
function (dismiss) {
  if (dismiss === 'timer') {
    //console.log('I was closed by the timer')
  }
}
);
}
window.onload = massge;
</script>
