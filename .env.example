APP_NAME="Stafo Backend"
APP_ENV=local
APP_KEY=base64:7K5p1o8vU2v6k5X/aLpW7dYvM9B+7lP4e8x3Y9u1Z2w=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Docker Host Port Forwarding
APP_PORT=8000
FORWARD_DB_PORT=3306
FORWARD_REDIS_PORT=6379
PMA_PORT=8081

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL Database (Docker Container service name: db)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=stafo_db
DB_USERNAME=stafo_user
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Redis Cache & Queues (Docker Container service name: redis)
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Node.js Chat Server Microservice
CHAT_PORT=6001
CHAT_HOST=0.0.0.0

# Python Face Verification Microservice
FACE_SERVICE_PORT=5005
FACE_SERVICE_URL=http://python:5005
FACE_SERVICE_TOLERANCE=0.50
FACE_SERVICE_TIMEOUT=10

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@stafo.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
